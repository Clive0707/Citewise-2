# Load order: cl-workers/app/main.py calls dotenv.load_dotenv()

# === LLM Providers (Primary: Gemini) ===
# Required for all Gemini calls (intent extraction, question generation, natural Q&A, competitor summaries, recommendations).
GEMINI_API_KEY="your-gemini-api-key"

# Optional: Select default provider; used by new provider factory in llm_providers/factory.py.
# Defaults to "gemini" if unset. Set to "gpt" to use OpenAI GPT fallback where coded.
LLM_PROVIDER="gemini"

# === RAG and Embeddings (OpenAI) ===
# Required for embeddings used in Step 5 (chunk embeddings) and Step 6 (query embeddings).
# Model: text-embedding-3-small (1536 dims)
OPENAI_API_KEY="your-openai-api-key"

# === Vector DB (Pinecone) ===
# Required. Used to store and retrieve chunk vectors for sandbox runs.
PINECONE_API_KEY="your-pinecone-api-key"

# Optional. Pinecone index name; defaults to "citelabs-sandbox" in code.
# Namespace per run = "sandbox-{run_id}".
PINECONE_INDEX_NAME="citelabs-sandbox"

# Optional. Region for Pinecone ServerlessSpec; defaults to "us-east-1".
PINECONE_REGION="us-east-1"

# Optional. Index dimension; defaults to 1536 (OpenAI text-embedding-3-small).
PINECONE_DIMENSION="1536"

# === Legacy / Optional (present in codebase but not used by the new AEO/GEO flow) ===

# Legacy: Old simulation (SERP-based competitor discovery) in app/simulation.py
# Optional. If using the legacy /simulate route. Not required for new AEO/GEO flow.
SERPAPI_KEY=""
SERP_API_ENDPOINT="https://serpapi.com/search"

# Legacy: Old embeddings path (sentence-transformers). Not used in new pipeline.
# Only used by cl-workers/app/embeddings.py if invoked (legacy simulation).
EMBEDDINGS_MODEL="BAAI/bge-small-en-v1.5"

# Legacy: Old LLM path for crawler summaries (still used by crawl.py through app/llm.py).
# Controls max content passed into summary prompts when using that legacy provider.
LLM_MAX_CONTENT_CHARS="6000"

# Legacy: Old general LLM provider (ollama/gemini) referenced in app/llm_provider.py
# New provider factory uses LLM_PROVIDER as well. Keep to "gemini" for consistency.
# LLM_PROVIDER above already covers this.

# Legacy: Supabase vector store (not used in new pipeline; Pinecone is required now).
SUPABASE_URL=""
SUPABASE_KEY=""

# Legacy: Vector store selector (FAISS/Supabase). New pipeline uses Pinecone directly.
# Kept for compatibility with legacy modules only.
VECTOR_DB_PROVIDER="faiss"