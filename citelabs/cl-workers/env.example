# LLM Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Backend URL for progress updates and result callbacks
BACKEND_BASE_URL=http://localhost:4000

# Optional - LLM Provider Selection (defaults to gemini)
# LLM_PROVIDER=gemini

# Optional - for competitor fetching
SERPAPI_KEY=your_serpapi_key_here

# Optional - for custom endpoints
SERP_API_ENDPOINT=https://serpapi.com/search

# Optional - LLM settings
OLLAMA_MODEL=llama3.1
OLLAMA_MAX_CONTENT_CHARS=6000

# Optional - Embeddings model
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5

# Optional - Chunking strategy (fixed or SEMENTIC)
# Use "SEMENTIC" for semantic chunking, any other value (or unset) for fixed-size chunking
CHUNKING_TYPE=fixed

# Optional - Worker URL override
WORKER_BASE_URL=http://localhost:8001

# Pinecone Configuration (if using Pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment_here
PINECONE_INDEX_NAME=your_index_name_here

# Supabase Configuration (if using Supabase)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

