# === Database (Prisma) ===
# Required. Postgres connection URL used by Prisma to persist sandbox runs, pages, questions, competitors, rag results, and scores.
DATABASE_URL="postgres://USER:PASSWORD@HOST:PORT/DB_NAME"

# === Worker Service ===
# Optional. Base URL for the Python FastAPI workers. Defaults to http://localhost:8001 if unset.
WORKER_BASE_URL="http://localhost:8001"